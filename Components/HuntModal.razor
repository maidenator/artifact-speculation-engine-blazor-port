@using ArtifactSpeculationBlazor.Models

<div class="hunt-modal-backdrop" @onclick="OnCancel">
    <div class="hunt-modal" @onclick:stopPropagation>
        <div class="hm-header">
            <h3>@(string.IsNullOrEmpty(_setId) ? "Any Set" : GameData.FindSetName(_setId))</h3>
            <button class="hm-close" @onclick="OnCancel">×</button>
        </div>

        <div class="hm-body">
            <div class="hm-slot-row">
                <div class="hm-slot-icons">
                    @for (int i = 0; i < 5; i++)
                    {
                        int slot = i;
                        <button class="hm-slot-btn @(_selectedSlot == slot ? "active" : "")" @onclick="() => SelectSlot(slot)">
                            <img src="@ArtifactData.GetSlotIcon(slot)" alt="@ArtifactData.GetSlotName(slot)" />
                        </button>
                    }
                </div>
                <div class="hm-slot-name">@ArtifactData.GetSlotName(_selectedSlot)</div>
            </div>

            <div class="hm-form-group">
                <label>MAIN STAT</label>
                <select value="@_selectedMainStat" @onchange="e => SelectMainStat(int.Parse(e.Value!.ToString()!))">
                    @foreach (var stat in MainOptions)
                    {
                        <option value="@stat">@ArtifactData.GetMainStatName(stat)</option>
                    }
                </select>
            </div>

            <div class="hm-main-display">
                <div class="hm-main-info">
                    <div class="hm-main-label">@(_selectedMainStat.HasValue ? ArtifactData.GetMainStatName(_selectedMainStat.Value) : "Any")</div>
                    <div class="hm-main-val">4,780</div>
                    <div class="hm-stars">
                        @for (int i = 0; i < 5; i++)
                        {
                            <span class="hm-star">★</span>
                        }
                    </div>
                </div>
                <div class="hm-art-img">
                    <img src="icons/artifactset/GladiatorFlower.png" />
                </div>
            </div>

            <div class="hm-dropdowns">
                <div class="hm-form-group">
                    <label>DOMAIN</label>
                    <select value="@_domainId" @onchange="e => SelectDomain(e.Value?.ToString())">
                        <option value="">Any</option>
                        @foreach (var domain in GameData.Domains)
                        {
                            <option value="@domain.Id">@domain.Name</option>
                        }
                    </select>
                </div>
                <div class="hm-form-group">
                    <label>SET</label>
                    <select @bind="_setId">
                        <option value="">Any</option>
                        @foreach (var set in AvailableSets)
                        {
                            <option value="@set.Id">@set.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="hm-substats">
                <div class="hm-substats-label">DESIRED SUBSTATS (@_substatRolls.Count/4) — @TotalRolls/@MaxTotalRolls ROLLS</div>
                <div class="hm-substats-grid">
                    @foreach (var stat in new[] { Stat.CritDMG, Stat.CritRate, Stat.ElementalMastery, Stat.EnergyRecharge, Stat.AtkPercent, Stat.FlatAtk, Stat.HpPercent, Stat.FlatHp, Stat.DefPercent, Stat.FlatDef })
                    {
                        bool isSelected = _substatRolls.ContainsKey(stat);
                        bool disabled = _substatRolls.Count >= 4 && !isSelected;
                        bool isMain = _selectedMainStat == stat;
                        <div class="hm-checkbox @(disabled || isMain ? "disabled" : "")">
                            <label>
                                <input type="checkbox" checked="@isSelected" disabled="@(disabled || isMain)" @onchange="() => ToggleSubstat(stat)" />
                                <img src="@ArtifactData.GetStatIcon(ArtifactData.GetSubStatName(stat))" class="hm-stat-icon" />
                                <span>@ArtifactData.GetSubStatName(stat)</span>
                            </label>
                            @if (isSelected)
                            {
                                <div class="hm-rolls">
                                    <button disabled="@(_substatRolls[stat] <= 1)" @onclick="() => ChangeRolls(stat, -1)">−</button>
                                    <span>@_substatRolls[stat]×</span>
                                    <button disabled="@(_substatRolls[stat] >= 6 || TotalRolls >= MaxTotalRolls)" @onclick="() => ChangeRolls(stat, 1)">+</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="hm-error">@_error</div>
            }
        </div>

        <div class="hm-footer">
            <button class="hm-btn-cancel" @onclick="OnCancel">Cancel</button>
            <button class="hm-btn-add" @onclick="AddToHuntList" disabled="@(!_selectedMainStat.HasValue)">Add to Hunt List</button>
        </div>
    </div>
</div>
