<article class="artifact-card-v2 skeleton-card">
    <div class="ac-set-bar">
        <div class="ac-set-left">
            <span class="skeleton-block" style="width: 40px; height: 16px;"></span>
            <span class="skeleton-block" style="width: 120px; height: 16px;"></span>
        </div>
    </div>
    
    <div class="ac-main-area" style="min-height: 128px;">
        <div class="ac-main-info">
            <div class="ac-slot-row">
                <span class="skeleton-block" style="width: 80px; height: 20px;"></span>
            </div>
            
            <div class="ac-main-stat-block">
                <span class="skeleton-block" style="width: 60px; height: 14px; margin-bottom: 8px;"></span>
                <span class="skeleton-block" style="width: 120px; height: 34px;"></span>
                
                <div class="ac-stars" style="margin-top: 8px;">
                    <span class="skeleton-block" style="width: 100px; height: 20px;"></span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="ac-substats">
        <span class="skeleton-block" style="width: 40px; height: 18px; margin-bottom: 0.5rem; display: inline-block;"></span>
        
        <ul class="ac-substat-list">
            @for (int i = 0; i < 4; i++)
            {
                <li class="ac-substat-row" style="margin-bottom: 4px;">
                    <span class="ac-substat-left">
                        <span class="skeleton-block" style="width: 16px; height: 16px; border-radius: 50%;"></span>
                        <span class="skeleton-block" style="width: 90px; height: 14px;"></span>
                    </span>
                    <span class="ac-substat-right">
                        <span class="skeleton-block" style="width: 40px; height: 14px;"></span>
                    </span>
                </li>
            }
        </ul>
    </div>
    
    <div class="ac-footer">
        <div class="ac-divider"></div>
        <div class="ac-score">
            <span class="skeleton-block" style="width: 70px; height: 14px;"></span>
            <span class="skeleton-block" style="width: 40px; height: 14px;"></span>
        </div>
    </div>
</article>
