@using ArtifactSpeculationBlazor.Models

<article class="artifact-card-v2 @AnimClass">
    @* ── Set Name Bar ── *@
    <div class="ac-set-bar">
        <div class="ac-set-left">
            <span class="ac-rank-badge">#@Rank</span>
            <span class="ac-set-name">@_setName</span>
        </div>
    </div>

    @* ── Main Stat Area with gradient background ── *@
    <div class="ac-main-area">
        @if (_mainStatIcon != null)
        {
            <img src="@_mainStatIcon" alt="" class="ac-main-watermark" />
        }

        <div class="ac-artifact-img">
            <img src="@_artifactIconSrc" alt="" @onerror="OnIconError" />
        </div>

        <div class="ac-main-info">
            <div class="ac-slot-row">
                @if (ArtifactData.GetSlotIcon(Artifact.Slot) is { } slotIcon)
                {
                    <img src="@slotIcon" alt="" class="ac-slot-icon" />
                }
                <span>@ArtifactData.GetSlotName(Artifact.Slot)</span>
            </div>

            <div class="ac-main-stat-block">
                <span class="ac-main-stat-label">@_mainStatName</span>
                <strong class="ac-main-stat-value">@ArtifactData.FormatStat(Artifact.MainStat.Type, Artifact.MainStat.Value)</strong>

                <div class="ac-stars">
                    @for (int s = 0; s < 5; s++)
                    {
                        <svg class="ac-star" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Substats Section ── *@
    <div class="ac-substats">
        <span class="ac-level-badge">+@Artifact.Level</span>

        <ul class="ac-substat-list">
            @for (int idx = 0; idx < Artifact.SubStats.Count; idx++)
            {
                var sub = Artifact.SubStats[idx];
                var subName = ArtifactData.GetSubStatName(sub.Type);
                var subIcon = ArtifactData.GetStatIcon(subName);
                var rollTiers = sub.RollTiers ?? ArtifactData.InferRollTiers(sub.Type, sub.Value, sub.Rolls);
                var isAnimating = UpgradeAnimation?.SubstatIndex == idx;

                <li class="ac-substat-row @(isAnimating ? "anim-row-flash" : "")">
                    <span class="ac-substat-left">
                        @if (subIcon != null)
                        {
                            <img src="@subIcon" alt="" class="ac-substat-icon" />
                        }
                        <span class="ac-substat-name">@subName</span>
                        <span class="ac-roll-dots">
                            @for (int d = 0; d < rollTiers.Length; d++)
                            {
                                var isNewDot = isAnimating && d == rollTiers.Length - 1;
                                <span class="ac-dot tier-@rollTiers[d] @(isNewDot ? "anim-dot-pop" : "")"
                                      title="Roll @(d + 1): @rollTiers[d]"></span>
                            }
                        </span>
                    </span>
                    <span class="ac-substat-right">
                        @ArtifactData.FormatStat(sub.Type, sub.Value)
                        @if (isAnimating && UpgradeAnimation != null)
                        {
                            <span class="anim-delta-pop ac-delta tier-color-@UpgradeAnimation.RollTier">
                                @ArtifactData.FormatStat(UpgradeAnimation.StatType, UpgradeAnimation.Delta)
                            </span>
                        }
                    </span>
                </li>
            }

            @if (PreviewSubstat != null && Artifact.SubStats.Count < 4)
            {
                var prevName = ArtifactData.GetSubStatName(PreviewSubstat.Value.Type);
                var prevIcon = ArtifactData.GetStatIcon(prevName);

                <li class="ac-substat-row ac-preview">
                    <span class="ac-substat-left">
                        @if (prevIcon != null)
                        {
                            <img src="@prevIcon" alt="" class="ac-substat-icon" />
                        }
                        <span class="ac-substat-name">@prevName</span>
                    </span>
                    <span class="ac-substat-right">
                        @ArtifactData.FormatStat(PreviewSubstat.Value.Type, PreviewSubstat.Value.Value)
                    </span>
                </li>
            }
        </ul>
    </div>

    @* ── Footer: CV Score ── *@
    <div class="ac-footer">
        <div class="ac-divider"></div>
        <div class="ac-score @_tierClass">
            <span>Crit Value</span>
            <strong>@Artifact.CritValue.ToString("F1")</strong>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public ArtifactOutput Artifact { get; set; } = default!;

    [Parameter]
    public int Rank { get; set; } = 1;

    [Parameter]
    public SubstatPreview? PreviewSubstat { get; set; }

    [Parameter]
    public UpgradeAnimationInfo? UpgradeAnimation { get; set; }

    private string _mainStatName = "";
    private string? _mainStatIcon;
    private string _setName = "Gladiator's Finale";
    private string _tierClass = "";
    private string _artifactIconSrc = "";
    private string _fallbackIcon = "";
    private string AnimClass => "";

    protected override void OnParametersSet()
    {
        _mainStatName = ArtifactData.GetMainStatName(Artifact.MainStat.Type);
        _mainStatIcon = ArtifactData.GetStatIcon(_mainStatName);
        _tierClass = ArtifactData.CvTier(Artifact.CritValue);

        var slotName = ArtifactData.GetSlotName(Artifact.Slot);
        _fallbackIcon = $"icons/artifactset/Gladiator{slotName}.png";
        _artifactIconSrc = Artifact.IconUrl ?? _fallbackIcon;
    }

    private void OnIconError()
    {
        _artifactIconSrc = _fallbackIcon;
    }

    public struct SubstatPreview
    {
        public int Type { get; set; }
        public double Value { get; set; }
    }

    public class UpgradeAnimationInfo
    {
        public int SubstatIndex { get; set; }
        public double Delta { get; set; }
        public string RollTier { get; set; } = "min";
        public int StatType { get; set; }
        public int Key { get; set; }
    }
}
