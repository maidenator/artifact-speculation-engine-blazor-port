@using ArtifactSpeculationBlazor.Components
@using ArtifactSpeculationBlazor.Components.Layout

<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
            </ChildContent>
            <ErrorContent>
                <LayoutView Layout="typeof(MainLayout)">
                    <p role="alert">Something went wrong rendering this page.</p>
                    <a href="" class="btn-secondary">Reload the app</a>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
