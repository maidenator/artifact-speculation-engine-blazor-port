@page "/"
@using ArtifactSpeculationBlazor.Services
@inject ArtifactEngineService Engine
@inject HuntListService HuntList
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Artifact Speculation Engine</PageTitle>

<div class="app-header">
    <h1>Artifact Speculation Engine</h1>
    <p class="subtitle">Monte Carlo artifact simulator powered by C++ WebAssembly</p>

    @if (!_engineReady && _engineError == null)
    {
        <div class="engine-status loading">
            <span class="status-dot"></span>
            Initializing engine...
        </div>
    }
    else if (_engineError != null)
    {
        <div class="engine-status error">
            <span class="status-dot"></span>
            @_engineError
        </div>
    }
    else
    {
        <div class="engine-status">
            <span class="status-dot"></span>
            Engine ready
        </div>
    }
</div>

<div class="content-grid">
    <!-- Config Panel -->
    <div class="config-panel">
        <div class="card">
            <div class="card-title">
                <img src="icons/resin.png" alt="" class="card-title-icon" />
                Resin Budget
            </div>

            <div class="form-group">
                <label class="form-label" for="resinBudget">Total Resin</label>
                <input id="resinBudget" type="number" class="form-input"
                       @bind="_settings.ResinBudget" min="20" step="20" />
                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 0.75rem;">
                    <button type="button" class="btn-secondary" @onclick="() => _settings.ResinBudget = 1260">1 week</button>
                    <button type="button" class="btn-secondary" @onclick="() => _settings.ResinBudget = 5400">1 month</button>
                    <button type="button" class="btn-secondary" @onclick="() => _settings.ResinBudget = 16200">3 months</button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="topK">Top Results</label>
                <input id="topK" type="number" class="form-input"
                       @bind="_settings.TopK" min="1" max="20" />
            </div>

            <div class="toggle-row">
                <span class="form-label" style="margin-bottom: 0;">
                    <img src="icons/strongbox.webp" alt="" class="inline-icon" />
                    Use Strongbox
                </span>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="_settings.UseStrongBox" />
                    <span class="toggle-track"></span>
                </label>
            </div>

            <div class="form-group">
                <label class="form-label" for="minCV">Min Crit Value</label>
                <input id="minCV" type="number" class="form-input"
                       @bind="_settings.MinCritValue" min="0" step="5" />
            </div>
        </div>

            <div class="form-group" style="margin-top: 1.5rem;">
                <label class="form-label" style="font-size: 11px;">How should the simulator spend resin?</label>
                <select class="form-select" @bind="_settings.Mode">
                    <option value="@SimulationMode.TargetPiece">Target specific artifact</option>
                    <option value="@SimulationMode.ResinBudget">Farm for Resin Budget</option>
                </select>
            </div>

            @if (_settings.Mode == SimulationMode.TargetPiece)
            {
                <div class="form-group" style="margin-top: 1rem;">
                    <label class="form-label" style="font-size: 11px;" for="targetSlot">Artifact type</label>
                    <select id="targetSlot" class="form-select" value="@(_settings.TargetSlot?.ToString() ?? "")" @onchange="OnTargetSlotChanged">
                        <option value="">Any piece</option>
                        @for (int i = 0; i < ArtifactData.SlotNames.Length; i++)
                        {
                            <option value="@i">@ArtifactData.SlotNames[i]</option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-top: 1rem;">
                    <label class="form-label" style="font-size: 11px;" for="targetMain">Main stat</label>
                    <select id="targetMain" class="form-select" value="@(_settings.TargetMainStat?.ToString() ?? "")" @onchange="OnTargetMainChanged">
                        <option value="">Any main stat</option>
                        @foreach (var stat in TargetMainOptions)
                        {
                            <option value="@stat">@ArtifactData.GetMainStatName(stat)</option>
                        }
                    </select>
                </div>

                <div class="form-group" style="margin-top: 1rem;">
                    <label class="form-label" style="font-size: 11px;" for="trials">Trials (independent runs)</label>
                    <input id="trials" type="number" class="form-input"
                           @bind="_settings.TrialCount" min="1" max="100" />
                </div>
            }

            <SubstatPriority Priority="_settings.Priority" PriorityChanged="OnPriorityChanged" />

        <button class="btn-primary @(_loading ? "loading" : "")"
                disabled="@(!CanRun)"
                @onclick="RunSimulation">
            @if (_loading)
            {
                <span class="btn-content"><span class="spinner"></span> Simulating...</span>
            }
            else
            {
                <span>Run Simulation</span>
            }
        </button>

        @if (_result != null || _targetResult != null || _huntResult != null)
        {
            <button class="btn-secondary" style="margin-top: 0.75rem; width: 100%;"
                    @onclick="Reset">
                Reset
            </button>
        }
        @if (_loading)
        {
            <button class="btn-secondary" style="margin-top: 0.75rem; width: 100%;"
                    @onclick="CancelRun">
                Cancel Run
            </button>
        }
    </div>

    <!-- Hunt Panel -->
    <div class="hunt-panel">
        <div class="card" style="height: 100%;">
            <div class="card-title">Hunt List</div>
            <div style="font-size: 12px; color: #8c93a0; margin-top: -10px; margin-bottom: 12px;">Define the artifacts you want to hunt for</div>
            
            @if (HuntList.Items.Count == 0)
            {
                <button style="width: 100%; padding: 1.5rem; background: transparent; border: 1px dashed rgba(255,255,255,0.2); border-radius: 8px; color: #8c93a0; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: background 0.2s;" @onclick="() => _showHuntModal = true" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
                    <div style="width: 20px; height: 20px; border-radius: 50%; background: #d5894b; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px;">+</div> Add Artifact
                </button>
            }
            else
            {
                <button style="width: 100%; padding: 0.75rem; background: transparent; border: 1px dashed rgba(255,255,255,0.2); border-radius: 8px; color: #8c93a0; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;" @onclick="() => _showHuntModal = true">
                    <div style="width: 20px; height: 20px; border-radius: 50%; background: #d5894b; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px;">+</div> Add Artifact
                </button>
                @foreach (var hunt in HuntList.Items)
                {
                    <div style="margin-top: 1rem; padding: 1rem; background: var(--card-inner); border-radius: 8px; border: 1px solid var(--line);">
                        <div style="color: #d5894b; font-weight: 700; margin-bottom: 0.5rem;">@ArtifactData.GetSlotName(hunt.Slot) Target</div>
                        <div style="color: white; font-size: 13px; margin-bottom: 0.25rem;">Main: @ArtifactData.GetMainStatName(hunt.MainStat)</div>
                        <div style="color: white; font-size: 13px;">Substats: @hunt.Substats.Count</div>
                        <div style="display: flex; gap: 1rem; margin-top: 0.75rem;">
                            <button style="background: none; border: none; color: var(--accent); font-weight: 600; cursor: pointer; padding: 0;" @onclick="() => StartEditHuntItem(hunt)">Edit</button>
                            <button style="background: none; border: none; color: var(--bad); font-weight: 600; cursor: pointer; padding: 0;" @onclick="() => RemoveHuntItem(hunt.Id)">Remove</button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Results Panel -->
    <div class="results-panel">
        @if (_runError != null)
        {
            <div class="error-banner">@_runError</div>
        }

        @if (_huntResult != null)
        {
            <div class="stat-grid animate-fade-in">
                <div class="stat-card">
                    <div class="stat-value">@(_huntResult.AllFound ? "Complete" : "Partial")</div>
                    <div class="stat-label">Hunt</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_huntResult.TotalResinSpent.ToString("N0")</div>
                    <div class="stat-label">Resin Spent</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_huntResult.TotalDays.ToString("F1")</div>
                    <div class="stat-label">Days</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_huntResult.DomainRunsCompleted.ToString("N0")</div>
                    <div class="stat-label">Domain Runs</div>
                </div>
            </div>

            @foreach (var itemResult in _huntResult.ItemResults)
            {
                var hunt = HuntList.Items.FirstOrDefault(h => h.Id == itemResult.HuntItemId);
                <div class="card-title" style="margin-top: 1rem;">
                    @(hunt is null ? "Target" : $"{ArtifactData.GetSlotName(hunt.Slot)} / {(hunt.MainStat >= 0 ? ArtifactData.GetMainStatName(hunt.MainStat) : "Any")}")
                    — @(itemResult.Found ? $"found at {itemResult.ResinSpent:N0} resin" : "not found in budget")
                </div>
                @if (itemResult.Artifact is not null)
                {
                    <div class="artifact-grid">
                        <ArtifactCard Artifact="itemResult.Artifact" />
                    </div>
                }
            }
            <p style="font-size: 12px; color: #8c93a0;">Hunt examines every drop at exact run cost (20 resin/run, 6.5% double drops). Strongbox not modeled in hunts.</p>
            <button class="btn-secondary" style="margin-top: 0.75rem;" @onclick="ExportHuntGood">Export found to GOOD</button>
        }
        else if (_targetResult != null)
        {
            var dist = _targetResult.Distribution;
            <div class="stat-grid animate-fade-in">
                <div class="stat-card">
                    <div class="stat-value">@(dist.SuccessRate.ToString("P0"))</div>
                    <div class="stat-label">Success in @dist.Attempts trials</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@(dist.P50Resin.HasValue ? dist.P50Resin.Value.ToString("N0") : "—")</div>
                    <div class="stat-label">Median resin (p50)</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@(dist.P90Resin.HasValue ? dist.P90Resin.Value.ToString("N0") : "—")</div>
                    <div class="stat-label">Unlucky resin (p90)</div>
                </div>
                @if (_elapsedMs.HasValue)
                {
                    <div class="stat-card">
                        <div class="stat-value">@(_elapsedMs.Value.ToString("F0"))ms</div>
                        <div class="stat-label">Elapsed</div>
                    </div>
                }
            </div>

            @if (_targetResult.MedianResult?.TopArtifacts.Count > 0)
            {
                <div class="card-title">Median trial artifacts</div>
                <div class="artifact-grid">
                    @foreach (var art in _targetResult.MedianResult!.TopArtifacts)
                    {
                        <ArtifactCard Artifact="art" />
                    }
                </div>
                <button class="btn-secondary" style="margin-top: 0.75rem;" @onclick="ExportTargetGood">Export to GOOD</button>
            }
        }
        else if (_result != null)
        {
            <p style="font-size: 12px; color: #8c93a0;">Single full-budget sample — one random draw, not a typical outcome.</p>
            <div class="stat-grid animate-fade-in">
                <div class="stat-card">
                    <div class="stat-value">@_result.TotalResinSpent.ToString("N0")</div>
                    <div class="stat-label">Resin Spent</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_result.EquivalentDays.ToString("F1")</div>
                    <div class="stat-label">Days</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_result.DomainRunsCompleted.ToString("N0")</div>
                    <div class="stat-label">Domain Runs</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@_result.TotalFiveStarsFound.ToString("N0")</div>
                    <div class="stat-label">5-Star Found</div>
                </div>
                @if (_result.StrongboxRollsCompleted > 0)
                {
                    <div class="stat-card">
                        <div class="stat-value">@_result.StrongboxRollsCompleted.ToString("N0")</div>
                        <div class="stat-label">Strongbox Rolls</div>
                    </div>
                }
                @if (_elapsedMs.HasValue)
                {
                    <div class="stat-card">
                        <div class="stat-value">@(_elapsedMs.Value.ToString("F0"))ms</div>
                        <div class="stat-label">Elapsed</div>
                    </div>
                }
            </div>

            @if (_result.TopArtifacts.Count > 0)
            {
                <div class="card-title">Top Artifacts</div>
                <div class="artifact-grid">
                    @foreach (var art in _result.TopArtifacts)
                    {
                        <ArtifactCard Artifact="art" />
                    }
                </div>
                <button class="btn-secondary" style="margin-top: 0.75rem;" @onclick="ExportResultGood">Export to GOOD</button>
            }
        }
        else if (_loading)
        {
            <div class="stat-grid animate-fade-in" style="opacity: 0.6;">
                <div class="stat-card skeleton-card"><div class="stat-value"><span class="skeleton-block" style="width: 80px; height: 38px; border-radius: 6px;"></span></div><div class="stat-label">Resin Spent</div></div>
                <div class="stat-card skeleton-card"><div class="stat-value"><span class="skeleton-block" style="width: 50px; height: 38px; border-radius: 6px;"></span></div><div class="stat-label">Days</div></div>
                <div class="stat-card skeleton-card"><div class="stat-value"><span class="skeleton-block" style="width: 60px; height: 38px; border-radius: 6px;"></span></div><div class="stat-label">Domain Runs</div></div>
                <div class="stat-card skeleton-card"><div class="stat-value"><span class="skeleton-block" style="width: 40px; height: 38px; border-radius: 6px;"></span></div><div class="stat-label">5-Star Found</div></div>
            </div>
            
            <div class="card-title" style="margin-top: 1rem;">Simulating...</div>
            <div class="artifact-grid">
                @for (int i = 0; i < Math.Min(4, _settings.TopK); i++)
                {
                    <SkeletonArtifactCard />
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <img src="icons/speculation.png" alt="" class="empty-state-icon" />
                <h3>No Results Yet</h3>
                <p>Configure your resin budget and run a simulation to see what artifacts you might find.</p>
            </div>
        }
    </div>
</div>

@if (_showHuntModal)
{
    <HuntModal EditingItem="_editingItem" OnAdd="OnAddHuntItem" OnCancel="CloseHuntModal" />
}

@code {
    private SimulationSettings _settings = new();
    private SimulationResult? _result;
    private TargetTrialResult? _targetResult;
    private HuntListResult? _huntResult;
    private CancellationTokenSource? _runCts;
    private bool _engineReady;
    private string? _engineError;
    private bool _loading;
    private string? _runError;
    private double? _elapsedMs;
    private bool _showHuntModal;
    private HuntItem? _editingItem;

    protected override async Task OnInitializedAsync()
    {
        HuntList.OnChange += PersistAndRefresh;
        await LoadHuntListAsync();
    }

    private async Task LoadHuntListAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", HuntListService.StorageKey);
            HuntList.LoadFromJson(json);
        }
        catch
        {
            // localStorage unavailable (prerendering/tests) — start empty.
        }
    }

    private void PersistAndRefresh()
    {
        _ = PersistHuntListAsync();
        StateHasChanged();
    }

    private async Task PersistHuntListAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", HuntListService.StorageKey, HuntList.ToJson());
        }
        catch
        {
            // Ignore persistence failures.
        }
    }

    private void OnPriorityChanged(int[] priority)
    {
        _settings.Priority = priority;
    }

    private int[] TargetMainOptions =>
        _settings.TargetSlot.HasValue
            ? GameData.MainStatsForSlot(_settings.TargetSlot.Value)
            : ArtifactData.MainStatNames.Keys.OrderBy(k => k).ToArray();

    private void OnTargetSlotChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _settings.TargetSlot = string.IsNullOrEmpty(raw) ? null : int.Parse(raw);
        // Mirror React changeSlot: drop the main stat if the new slot can't have it.
        if (_settings.TargetSlot.HasValue && _settings.TargetMainStat.HasValue
            && !GameData.MainStatsForSlot(_settings.TargetSlot.Value).Contains(_settings.TargetMainStat.Value))
            _settings.TargetMainStat = null;
    }

    private void OnTargetMainChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _settings.TargetMainStat = string.IsNullOrEmpty(raw) ? null : int.Parse(raw);
    }

    private void OnAddHuntItem(HuntItem item)
    {
        if (_editingItem is not null)
            HuntList.Update(_editingItem.Id, item);
        else
            HuntList.Add(item);
        CloseHuntModal();
    }

    private void StartEditHuntItem(HuntItem hunt)
    {
        _editingItem = hunt;
        _showHuntModal = true;
    }

    private void CloseHuntModal()
    {
        _showHuntModal = false;
        _editingItem = null;
    }

    private void RemoveHuntItem(string id)
    {
        HuntList.Remove(id);
    }

    public void Dispose()
    {
        HuntList.OnChange -= PersistAndRefresh;
    }

    private bool CanRun => _engineReady && !_loading && _settings.ResinBudget >= 20;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Engine.InitAsync(DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
                _engineReady = true;
            }
            catch (Exception ex)
            {
                _engineError = $"Failed to initialize engine: {ex.Message}";
            }
            StateHasChanged();
        }
    }

    private async Task RunSimulation()
    {
        SimulationValidation.Normalize(_settings);
        if (!CanRun) return;

        _loading = true;
        _runError = null;
        _result = null;
        _targetResult = null;
        _huntResult = null;
        StateHasChanged();

        // Yield to the UI thread so the skeleton loading screen can actually render
        await Task.Delay(1);

        try
        {
            if (HuntList.Items.Count > 0)
            {
                _runCts?.Dispose();
                _runCts = new CancellationTokenSource();
                var runner = new HuntRunner(count => Engine.GenerateBatchAsync(count, upgrade: true));
                var huntResult = await runner.RunHuntAsync(HuntList.Items, _settings.ResinBudget, _runCts.Token);
                _huntResult = huntResult;
                _elapsedMs = huntResult.ElapsedMs;
            }
            else if (_settings.Mode == SimulationMode.TargetPiece)
            {
                _runCts?.Dispose();
                _runCts = new CancellationTokenSource();
                var trials = await Engine.RunTargetTrialsAsync(_settings, _settings.TrialCount, _runCts.Token);
                _targetResult = trials;
                _elapsedMs = trials.ElapsedMs;
            }
            else
            {
                var sw = System.Diagnostics.Stopwatch.StartNew();
                _result = await Engine.RunSimulationAsync(_settings);
                sw.Stop();
                _elapsedMs = sw.Elapsed.TotalMilliseconds;
            }
        }
        catch (OperationCanceledException)
        {
            _runError = "Run cancelled.";
        }
        catch (Exception ex)
        {
            _runError = $"Simulation error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void CancelRun()
    {
        _runCts?.Cancel();
    }

    private async Task ExportGoodAsync(IEnumerable<ArtifactOutput> artifacts, string filename)
    {
        var doc = GoodExportService.ToGoodDocument(artifacts);
        var json = System.Text.Json.JsonSerializer.Serialize(doc);
        await JS.InvokeVoidAsync("artifactEngine.downloadFile", filename, json, "application/json");
    }

    private Task ExportResultGood() =>
        ExportGoodAsync(_result?.TopArtifacts ?? [], "artifacts-good.json");

    private Task ExportTargetGood() =>
        ExportGoodAsync(_targetResult?.MedianResult?.TopArtifacts ?? [], "target-good.json");

    private Task ExportHuntGood() =>
        ExportGoodAsync(
            (_huntResult?.ItemResults ?? [])
                .Where(r => r.Artifact is not null)
                .Select(r => r.Artifact!),
            "hunt-good.json");

    private void Reset()
    {
        _settings = new SimulationSettings();
        _result = null;
        _targetResult = null;
        _huntResult = null;
        _elapsedMs = null;
        _runError = null;
    }
}
