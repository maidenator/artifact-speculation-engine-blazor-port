@page "/sandbox"
@inject ArtifactEngineService Engine

<PageTitle>Artifact Sandbox</PageTitle>

<div class="app-header">
    <h1>Artifact Sandbox</h1>
    <p class="subtitle">Generate and inspect individual artifacts</p>
</div>

<div class="content-grid">
    <div class="config-panel">
        <div class="card">
            <div class="card-title">Generate</div>

            <div class="form-group">
                <label class="form-label" for="batchCount">Count</label>
                <input id="batchCount" type="number" class="form-input"
                       @bind="_count" min="1" max="1000" />
            </div>

            <div class="toggle-row">
                <span class="form-label" style="margin-bottom: 0;">Upgrade to +20</span>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="_upgrade" />
                    <span class="toggle-track"></span>
                </label>
            </div>

            <button class="btn-primary @(_loading ? "loading" : "")"
                    disabled="@(!_engineReady || _loading)"
                    @onclick="Generate">
                @if (_loading)
                {
                    <span class="btn-content"><span class="spinner"></span> Generating...</span>
                }
                else
                {
                    <span>Generate @_count Artifact@(_count != 1 ? "s" : "")</span>
                }
            </button>
        </div>
    </div>

    <div class="results-panel">
        @if (_artifacts.Count > 0)
        {
            <div class="card-title">Generated Artifacts (@_artifacts.Count)</div>
            <div class="artifact-grid">
                @foreach (var art in _artifacts)
                {
                    <ArtifactCard Artifact="art" />
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <img src="icons/domain.png" alt="" class="empty-state-icon" />
                <h3>Sandbox Mode</h3>
                <p>Generate artifacts to inspect their stats, substats, and roll distributions.</p>
            </div>
        }
    </div>
</div>

@code {
    private int _count = 10;
    private bool _upgrade = true;
    private bool _loading;
    private bool _engineReady;
    private List<ArtifactOutput> _artifacts = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (!Engine.IsReady)
                    await Engine.InitAsync(DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
                _engineReady = true;
                StateHasChanged();
            }
            catch
            {
                // Engine initialization handled on main page
            }
        }
    }

    private async Task Generate()
    {
        if (!_engineReady || _loading) return;

        _loading = true;
        StateHasChanged();

        try
        {
            _artifacts = await Engine.GenerateBatchAsync(_count, _upgrade);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Batch generation error: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
